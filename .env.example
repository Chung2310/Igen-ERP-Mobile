EXPO_PUBLIC_API_URL=https://staging-erp.igentechnology.net
# Web pages for privacy policy and terms. May be empty when web and API share an origin.
EXPO_PUBLIC_ERP_WEB_URL=https://staging-erp.igentechnology.net

# Local native settings. CI reads GitHub Variables instead of .env.
APP_VERSION=1.0.0
ERP_IOS_BUNDLE_IDENTIFIER=com.igen.erp
IOS_BUILD_NUMBER=1

# Apple signing credentials belong in GitHub Secrets, never EXPO_PUBLIC_* variables.
