{
  "expo": {
    "name": "ERP Mobile",
    "slug": "erp-mobile",
    "scheme": "erpmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép ERP Mobile chọn ảnh để tạo Lead bằng OCR.",
          "cameraPermission": "Cho phép ERP Mobile chụp tài liệu để tạo Lead bằng OCR.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.igen.erp.mobile"
    },
    "android": {
      "package": "vn.igen.erp.mobile"
    }
  }
}
